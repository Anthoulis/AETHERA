# Supabase Edge Function secrets. Copy to an ignored local env file and replace
# every placeholder; never expose these values in browser JavaScript.
RESEND_API_KEY=replace_with_resend_api_key
ENQUIRY_RECIPIENT_EMAIL=hello@aethera.gr
ENQUIRY_FROM_EMAIL=AETHERA <enquiries@aethera.gr>
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key
ALLOWED_ORIGINS=https://www.aethera.gr,http://localhost:8000
UPSTASH_REDIS_REST_URL=https://replace-with-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token
RATE_LIMIT_IP_SALT=replace_with_at_least_32_random_characters

# The Turnstile site key and deployed function URL are public frontend
# configuration. They are intentionally not server secrets in this file.
